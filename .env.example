# Required. Generate with: pnpm token
MCP_TOKEN=

# Primary project root. Relative tool paths resolve here.
WORKSPACE_PATH=/absolute/path/to/your/project

# Optional additional roots separated by the OS path delimiter (: on macOS/Linux, ; on Windows).
EXTRA_WORKSPACE_PATHS=

HOST=127.0.0.1
PORT=3000

# Legacy public-tunnel compatibility. This places MCP_TOKEN in the URL and can
# leak through history/provider logs. Keep false when using Secure MCP Tunnel.
ALLOW_URL_TOKEN=false
AUTO_START_TUNNEL=false
TUNNEL_PROVIDER=cloudflared

# read-only | workspace-write
PERMISSION_MODE=workspace-write

# High-risk capabilities are absent unless explicitly enabled.
ALLOW_DESTRUCTIVE=false
ALLOW_REMOTE_GIT=false
ALLOW_UNSAFE_SHELL=false
ALLOW_SENSITIVE_FILES=false

# Exact operator-defined commands. Defaults to <WORKSPACE_PATH>/.local-coder/tasks.json.
TASKS_FILE=
TASK_TIMEOUT_SECONDS=300

READ_MAX_BYTES=524288
WRITE_MAX_BYTES=1048576
TOOL_OUTPUT_MAX_BYTES=262144
HTTP_BODY_MAX_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=16
MAX_BACKGROUND_TASKS=4
COMPLETED_TASK_RETENTION=50
AUDIT_MAX_BYTES=5242880
CHECKPOINT_RETENTION=25

# Local control dashboard at http://127.0.0.1:<ADMIN_PORT>/ui.
# It can select the primary workspace, change capability flags and control the MCP tunnel.
# Disabled unless both fields are set. Never expose this port through the tunnel.
ADMIN_ENABLED=false
ADMIN_PORT=3001
ADMIN_TOKEN=
